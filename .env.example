# Required for Docker Compose. Replace both demo values with long random secrets.
POSTGRES_PASSWORD=replace-with-a-long-random-password
NEO4J_PASSWORD=replace-with-a-different-long-random-password

# Optional services.
GEMINI_API_KEY=
OPENFDA_API_KEY=
ANUVAAD_PROVIDER_ID=anuvaad-demo

# Leave these empty unless you registered Anuvaad with a SMART-on-FHIR server.
FHIR_BASE_URL=
FHIR_CLIENT_ID=
ANUVAAD_PUBLIC_URL=http://localhost:3002

# Optional public app port on the host machine.
APP_PORT=3002
